        <mxCell id="zsTvJLVm9VkWRjEkipdc-6" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Admin Relative URL&lt;/h1&gt;&lt;p&gt;The ability to do admin access on any route. Requires permissions. Failed will redirect back.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
